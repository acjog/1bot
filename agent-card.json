{
  "name": "Agent Gateway",
  "description": "多 Agent 通信网关，作为 Orchestrator 与 Remote Bot（Worker）之间的桥接层。提供任务路由、进度推送、服务发现、多租户隔离等能力。",
  "url": "http://127.0.0.1:8443",
  "version": "0.1.0",
  "protocol": "a2a",
  "protocolVersion": "0.2.0",
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "stateTransitionHistory": false
  },
  "skills": [
    {
      "id": "task_dispatch",
      "name": "Task Dispatch",
      "description": "Orchestrator 通过 HTTP/JSON-RPC 向 Gateway 提交任务，Gateway 根据 skill 匹配 + 最低负载策略，自动路由到合适的 Remote Bot 执行",
      "tags": ["orchestrator", "orchestration", "routing"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
        "POST /tasks {\"skill\":\"summarize\",\"instruction\":\"请摘要...\"}",
        "JSON-RPC: {\"method\":\"tasks/send\",\"params\":{\"skill\":\"translate\",\"instruction\":\"...\"}}"
      ]
    },
    {
      "id": "task_query",
      "name": "Task Query",
      "description": "Orchestrator 查询任务的当前状态、结果或错误信息",
      "tags": ["orchestrator", "query"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
        "GET /tasks/:task_id",
        "JSON-RPC: {\"method\":\"tasks/get\",\"params\":{\"taskId\":\"t-xxx\"}}"
      ]
    },
    {
      "id": "task_stream",
      "name": "Task Progress Stream (SSE)",
      "description": "Orchestrator 通过 SSE 实时订阅任务进度流，接收 queued/running/progress/completed/failed 等事件",
      "tags": ["orchestrator", "streaming", "sse"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
        "GET /tasks/:task_id/stream → event: progress, data: {\"pct\":50,\"message\":\"processing...\"}",
        "curl -N http://127.0.0.1:8443/tasks/t-xxx/stream"
      ]
    },
    {
      "id": "agent_discovery",
      "name": "Agent Discovery",
      "description": "Orchestrator 查询当前在线的 Agent 列表，包括技能、负载、连接时间等信息",
      "tags": ["orchestrator", "discovery"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
        "GET /agents",
        "JSON-RPC: {\"method\":\"agents/list\",\"params\":{}}"
      ]
    },
    {
      "id": "agent_register",
      "name": "Agent Register (WebSocket)",
      "description": "Remote Bot 通过 WebSocket 主动连接 Gateway 注册自身能力（Agent Card），建立全双工长连接用于接收任务和上报进度",
      "tags": ["remote_bot", "websocket", "registration"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
        "ws://127.0.0.1:8080/agent/register → send: {\"type\":\"register\",\"card\":{...},\"namespace\":\"production\"}",
        "wss://127.0.0.1:8080/agent/register (mTLS 模式)"
      ]
    },
    {
      "id": "progress_report",
      "name": "Progress Report",
      "description": "Remote Bot 通过 WebSocket 上报任务执行进度（百分比 + 描述），Gateway 实时转发给订阅 SSE 的 Orchestrator",
      "tags": ["remote_bot", "websocket", "progress"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
        "{\"type\":\"progress\",\"task_id\":\"t-xxx\",\"status\":\"running\",\"pct\":50,\"message\":\"处理中...\"}",
        "{\"type\":\"result\",\"task_id\":\"t-xxx\",\"artifact\":{\"text\":\"结果...\"}}"
      ]
    },
    {
      "id": "heartbeat",
      "name": "Heartbeat & Health Check",
      "description": "Gateway 定时向 Remote Bot 下发 ping 探活，Remote Bot 回复 pong。超时 30s 未响应的 Agent 自动摘除",
      "tags": ["remote_bot", "health", "keepalive"],
      "inputModes": ["text"],
      "outputModes": ["text"],
      "examples": [
      "Gateway → Remote Bot: {\"type\":\"ping\"}",
        "Remote Bot → Gateway: {\"type\":\"pong\"}"
      ]
    }
  ],
  "defaultInputModes": ["text"],
  "defaultOutputModes": ["text"],
  "provider": {
    "organization": "Agent Gateway",
    "url": "https://github.com/agent-gateway"
  },
  "authentication": {
    "schemes": ["bearer"],
    "credentials": null
  },
  "supportsAuthenticatedExtendedCard": false,
  "endpoints": {
    "orchestrator": {
      "base_url": "http://127.0.0.1:8443",
      "auth": "OAuth2 Bearer JWT",
      "routes": {
        "agent_card": "GET /.well-known/agent.json",
        "create_task": "POST /tasks",
        "get_task": "GET /tasks/:task_id",
        "sse_stream": "GET /tasks/:task_id/stream",
        "list_agents": "GET /agents",
        "jsonrpc": "POST /jsonrpc",
        "health": "GET /health"
      }
    },
    "remote_bot": {
      "base_url": "ws://127.0.0.1:8080",
      "auth": "mTLS 客户端证书",
      "routes": {
        "register": "GET /agent/register (WebSocket Upgrade)",
        "health": "GET /health"
      }
    }
  }
}
